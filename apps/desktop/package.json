{
  "name": "@dshd/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for DeepSeek Harness",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "icons": "node ../../scripts/generate-icon.mjs",
    "package": "node scripts/prepare-runtime.mjs --release && electron-vite build && electron-builder",
    "verify:runtime": "node scripts/verify-packaged-runtime.mjs",
    "verify:licenses": "node ../../scripts/verify-licenses.mjs",
    "verify:mac": "node scripts/verify-packaged-runtime.mjs && node ../../scripts/verify-licenses.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dshd/permissions": "workspace:*",
    "@dshd/protocol": "workspace:*",
    "@dshd/session-store": "workspace:*",
    "@dshd/ui": "workspace:*",
    "electron-updater": "^6.8.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2"
  }
}