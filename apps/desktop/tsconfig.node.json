{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@dshd/protocol": ["./../../packages/protocol/src/index.ts"],
      "@dshd/session-store": ["./../../packages/session-store/src/index.ts"],
      "@dshd/permissions": ["./../../packages/permissions/src/index.ts"]
    }
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"]
}
