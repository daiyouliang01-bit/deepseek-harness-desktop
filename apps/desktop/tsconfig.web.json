{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@dshd/ui": ["./../../packages/ui/src/index.ts"],
      "@dshd/protocol": ["./../../packages/protocol/src/index.ts"],
      "@electron/*": ["./electron/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
